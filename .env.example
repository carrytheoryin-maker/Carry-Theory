# APP_URL: Canonical public URL where this site is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Required for accessing the hidden admin portal (/admin and /api/admin/*).
# Leave blank in preview to claim an initial passcode directly on /admin.
ADMIN_PASSCODE=

# CORS_ORIGIN: Optional comma-separated allowlist of trusted browser origins for API requests.
CORS_ORIGIN=

# GOOGLE_SCRIPT_WEBHOOK_URL: Server-side Google Apps Script Web App URL for Orders, Newsletter & Contact Messages.
GOOGLE_SCRIPT_WEBHOOK_URL=
